{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32 (OpenOCD)",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/Debug/LF_STM32.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "preLaunchTask": "CompileDebug",
            "gdbPath": "gdb",
            // Add the svd file [https://www.st.com/en/microcontrollers-microprocessors/stm32g474rc.html#cad-resources]
            "svdFile": "${workspaceRoot}/STM32G474.svd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32g4x.cfg"
            ],
            "showDevDebugOutput": "none",
            // Applied only on macOS. Linux/Windows keep gdbPath "gdb" above.
            "osx": {
                "gdbPath": "/opt/homebrew/bin/arm-none-eabi-gdb",
                "serverpath": "/opt/homebrew/bin/openocd"
            }
        },

        
        /*
         * The following cofiguration runs debug using the official
         * ST-LINK_gdbserver from STM32CubeCLT
         */
        // {
        //     "name": "Debug STM32 (STM32CubeCLT)",
