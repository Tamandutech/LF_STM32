{
    "files.associations": {
        // All files
        "*.c": "c",
        "*.h": "c",
        "*.cpp": "cpp",
        "*.hpp": "cpp",
        "*.postcss": "tailwindcss",
        "*.svelte": "svelte",
        "*.html": "html",
        ".clang-tidy": "yaml",
        // C specific
        "string.h": "c",
        "math.h": "c",
        "type.h": "c",
        "locale.h": "c",
        "stdarg.h": "c",
        "stddef.h": "c",
        "stdio.h": "c",
        "stdlib.h": "c",
        "time.h": "c",
        "wchar.h": "c",
        "wctype.h": "c",
        "inttypes.h": "c",
        "ble_svc_gap.h": "c",
        "freertos.h": "c",
        // C++ specific
        "cstdint": "cpp",
        "array": "cpp",
        "string_view": "cpp",
        "initializer_list": "cpp",
        "utility": "cpp",
        "atomic": "cpp",
        "*.tcc": "cpp",
        "cctype": "cpp",
        "clocale": "cpp",
        "cmath": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "deque": "cpp",
        "unordered_map": "cpp",
        "unordered_set": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "algorithm": "cpp",
        "functional": "cpp",
        "iterator": "cpp",
        "map": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "optional": "cpp",
        "random": "cpp",
        "string": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "fstream": "cpp",
        "iomanip": "cpp",
        "iosfwd": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "new": "cpp",
        "ostream": "cpp",
        "sstream": "cpp",
        "stdexcept": "cpp",
        "streambuf": "cpp",
        "cinttypes": "cpp",
        "typeinfo": "cpp",
        "span": "cpp",
        "bit": "cpp",
        "charconv": "cpp",
        "compare": "cpp",
        "concepts": "cpp",
        "set": "cpp",
        "format": "cpp",
        "numbers": "cpp",
        "text_encoding": "cpp",
        "variant": "cpp",
        "bitset": "cpp",
        "chrono": "cpp",
        "condition_variable": "cpp",
        "ratio": "cpp",
        "mutex": "cpp",
        "semaphore": "cpp",
        "stop_token": "cpp",
        "thread": "cpp",
        "iostream": "cpp"
    },
    // Editor
    "editor.tabSize": 2,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    // Set here the path for clangd:
    // Linux/WSL keep /usr/bin/clangd. The wrapper is used so macOS can
    // resolve Homebrew LLVM without replacing the Linux path.
    "clangd.path": "${workspaceFolder}/scripts/clangd",
    "clangd.detectExtensionConflicts": true,
    "clangd.enableCodeCompletion": true,
    "clangd.arguments": [
        // Set here the path of your compiler:
        // Unused globs are ignored; Linux still queries /usr/bin/arm-none-eabi-gcc.
        "--query-driver=/usr/bin/arm-none-eabi-gcc,/usr/bin/arm-none-eabi-g++,/opt/homebrew/bin/arm-none-eabi-gcc,/opt/homebrew/bin/arm-none-eabi-g++,/usr/local/bin/arm-none-eabi-gcc,/usr/local/bin/arm-none-eabi-g++,/Applications/ArmGNUToolchain/*/arm-none-eabi/bin/arm-none-eabi-gcc,/Applications/ArmGNUToolchain/*/arm-none-eabi/bin/arm-none-eabi-g++"
    ],
    // *.osx keys are read only on macOS. Linux/Windows keep launch.json "gdb".
    "cortex-debug.gdbPath.osx": "/opt/homebrew/bin/arm-none-eabi-gdb",
    "cortex-debug.openocdPath.osx": "/opt/homebrew/bin/openocd",
    "cortex-debug.armToolchainPath.osx": "/opt/homebrew/bin",
    "terminal.integrated.env.osx": {
        "PATH": "/opt/homebrew/bin:/opt/homebrew/sbin:/opt/homebrew/opt/llvm/bin:${env:PATH}"
    }
}